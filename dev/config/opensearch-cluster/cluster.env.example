# Image identique a celle de la plateforme Oculox 26.07.1.
OCULOX_CLUSTER_PROFILE=production
OPENSEARCH_IMAGE=ghcr.io/idaholab/malcolm/opensearch:26.07.1

# Identite commune des trois noeuds.
OPENSEARCH_CLUSTER_NAME=oculox-opensearch

# Decouverte permanente sur le reseau Docker prive.
OPENSEARCH_DISCOVERY_SEED_HOSTS=opensearch-1:9300,opensearch-2:9300,opensearch-3:9300

# Liste utilisee uniquement avec compose.bootstrap.yml au premier amorcage.
# Les valeurs correspondent exactement aux trois node.name.
OPENSEARCH_INITIAL_CLUSTER_MANAGER_NODES=opensearch-1,opensearch-2,opensearch-3

# Exemple pour une VM de qualification : 2 Gio par JVM, soit 6 Gio au total.
OPENSEARCH_HEAP_SIZE=2g

# Redemarrage automatique apres reboot, sauf arret volontaire de l'operateur.
OPENSEARCH_RESTART_POLICY=unless-stopped

# Endpoint stable publie par le proxy HAProxy de l.endpoint stable.
OPENSEARCH_CLUSTER_ENDPOINT=https://192.0.2.10:9200
OPENSEARCH_ENDPOINT_BIND_IP=192.0.2.10
OPENSEARCH_ENDPOINT_PORT=9200
OPENSEARCH_MONITORING_PORT=8404
OPENSEARCH_PROXY_IMAGE=haproxy:3.2.21-alpine
OPENSEARCH_PROXY_UID=1000
OPENSEARCH_PROXY_GID=1000

# Stockage et politiques. Les suppressions restent désactivées tant qu'un
# repository de snapshots externe n'a pas été validé.
OPENSEARCH_PRIMARY_SHARDS=1
OPENSEARCH_REPLICAS=1
OPENSEARCH_MAX_DOCVALUE_FIELDS_SEARCH=200
OPENSEARCH_WATERMARK_LOW=75
OPENSEARCH_WATERMARK_HIGH=85
OPENSEARCH_WATERMARK_FLOOD_STAGE=90
OPENSEARCH_POLICY_ARKIME_SESSIONS_ENABLED=true
OPENSEARCH_POLICY_ARKIME_SESSIONS_OPTIMIZE_DAYS=30
OPENSEARCH_POLICY_ARKIME_SESSIONS_DELETE_ENABLED=false
OPENSEARCH_POLICY_ARKIME_SESSIONS_DELETE_DAYS=90
OPENSEARCH_POLICY_ARKIME_HISTORY_ENABLED=true
OPENSEARCH_POLICY_ARKIME_HISTORY_DELETE_ENABLED=false
OPENSEARCH_POLICY_ARKIME_HISTORY_DELETE_DAYS=91
OPENSEARCH_POLICY_BEATS_ENABLED=true
OPENSEARCH_POLICY_BEATS_OPTIMIZE_DAYS=30
OPENSEARCH_POLICY_BEATS_DELETE_ENABLED=false
OPENSEARCH_POLICY_BEATS_DELETE_DAYS=90
OPENSEARCH_SNAPSHOTS_ENABLED=false
