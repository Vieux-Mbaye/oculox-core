# variables prefixed by KEYCLOAK_ are used by both external and embedded Keycloak instances
KEYCLOAK_AUTH_REALM=oculox
KEYCLOAK_BOOTSTRAP_REALM=master
KEYCLOAK_AUTH_REDIRECT_URI=/index.html
KEYCLOAK_AUTH_URL=
KEYCLOAK_NGINX_CONNECT_URL=http://keycloak:8080/keycloak
KEYCLOAK_DASHBOARDS_CONNECT_URL=http://keycloak:8080/keycloak
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
# Keep the embedded Keycloak service off while Basic remains active. The
# `./oculox keycloak provision` command enables it only for reconciliation.
KEYCLOAK_PROVISIONING_ENABLED=false
KEYCLOAK_PORTAL_CLIENT_ID=oculox-portal
KEYCLOAK_PORTAL_CLIENT_SECRET=
KEYCLOAK_DASHBOARDS_CLIENT_ID=oculox-dashboards
KEYCLOAK_DASHBOARDS_CLIENT_SECRET=
KEYCLOAK_DASHBOARDS_REDIRECT_URI=
KEYCLOAK_PROVISIONER_CLIENT_ID=oculox-realm-provisioner
KEYCLOAK_PROVISIONER_CLIENT_SECRET=
KEYCLOAK_RECOVERY_CLIENT_ID=
KEYCLOAK_RECOVERY_CLIENT_SECRET=
# These short-lived values are populated only during provisioning, then cleared.
KEYCLOAK_INITIAL_ADMIN_USERNAME=
KEYCLOAK_INITIAL_ADMIN_PASSWORD=
KEYCLOAK_CONSOLE_ADMIN_USERNAME=oculox-keycloak-admin
KEYCLOAK_CONSOLE_ADMIN_PASSWORD=
KEYCLOAK_USER_ADMIN_PASSWORD=
KEYCLOAK_USER_ANALYST_PASSWORD=
KEYCLOAK_USER_VIEWER_PASSWORD=
KEYCLOAK_USER_INCIDENT_RESPONSE_PASSWORD=
KEYCLOAK_USER_DENIED_PASSWORD=
KEYCLOAK_SSL_VERIFY=true
KEYCLOAK_PASSWORD_MIN_LENGTH=14
KEYCLOAK_ACCESS_TOKEN_LIFESPAN_SECONDS=300
KEYCLOAK_SSO_SESSION_IDLE_SECONDS=1800
KEYCLOAK_SSO_SESSION_MAX_SECONDS=28800
KEYCLOAK_EVENTS_EXPIRATION_SECONDS=604800
KEYCLOAK_MFA_REQUIRED=true

# variables prefixed by KC_ are only used by Malcolm's embedded Keycloak instance
KC_CACHE=local
KC_HEALTH_ENABLED=true
KC_HOSTNAME=
KC_HOSTNAME_BACKCHANNEL_DYNAMIC=true
KC_HOSTNAME_STRICT=true
KC_HTTP_ENABLED=true
KC_HTTP_RELATIVE_PATH=/keycloak
KC_METRICS_ENABLED=false
KC_PROXY_HEADERS=xforwarded

KC_BOOTSTRAP_ADMIN_USERNAME=
KC_BOOTSTRAP_ADMIN_PASSWORD=

K8S_SECRET=True
